rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /dsa-headings/{headingId} {
      allow read: if true;
      allow write: if request.auth != null;
      match /dsa-subheadings/{subheadingId} {
        allow read: if true;
        allow write: if request.auth != null;
        match /dsa-questions/{questionId} {
          allow read: if true;
          allow write: if request.auth != null;
        }
      }
    }

    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
